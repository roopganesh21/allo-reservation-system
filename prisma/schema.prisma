// Generate Prisma schema with models: Product, Warehouse, Inventory, Reservation
// Product has id (cuid) and name
// Warehouse has id (cuid) and name
// Inventory has totalUnits, reservedUnits (default 0), belongs to Product and Warehouse
// Inventory has unique constraint on productId + warehouseId
// Reservation has status enum: PENDING, CONFIRMED, RELEASED
// Reservation has quantity, expiresAt DateTime, createdAt, belongs to Inventory

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id        String      @id @default(cuid())
  name      String
  inventory Inventory[]
}

model Warehouse {
  id        String      @id @default(cuid())
  name      String
  inventory Inventory[]
}

model Inventory {
  id            String        @id @default(cuid())
  productId     String
  warehouseId   String
  totalUnits    Int
  reservedUnits Int           @default(0)
  product       Product       @relation(fields: [productId], references: [id])
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  reservations  Reservation[]

  @@unique([productId, warehouseId])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  RELEASED
}

model Reservation {
  id          String            @id @default(cuid())
  inventoryId String
  quantity    Int
  status      ReservationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  inventory   Inventory         @relation(fields: [inventoryId], references: [id])
}
